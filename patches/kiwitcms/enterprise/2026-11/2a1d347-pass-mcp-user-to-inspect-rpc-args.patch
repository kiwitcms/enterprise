From 2a1d34797d53f87d14f2684513c2d00ac6593a7a Mon Sep 17 00:00:00 2001
From: Alexander Todorov <atodorov@otb.bg>
Date: Sun, 15 Nov 2026 14:55:59 +0000
Subject: [PATCH] Pass MCP user to inspect_rpc_args

---
 tcms_enterprise/mcp_server.py            |  8 +++++---
 tcms_enterprise/tests/test_mcp_server.py | 17 +++++++++++++++++
 2 files changed, 22 insertions(+), 3 deletions(-)

diff --git a/tcms_enterprise/mcp_server.py b/tcms_enterprise/mcp_server.py
index 8b80d96..2441188 100644
--- a/tcms_enterprise/mcp_server.py
+++ b/tcms_enterprise/mcp_server.py
@@ -311,12 +311,14 @@ class MCPServer(RpcServer):
         if method is None or name in MCP_EXCLUDED_TOOLS:
             return self.error_result(f"Unknown tool: {name}")
 
+        request = mcp_context.request
+
         try:
-            KiwiTCMSHandlerMixin.inspect_rpc_args(name, kwargs=arguments or {})
+            KiwiTCMSHandlerMixin.inspect_rpc_args(
+                name, kwargs=arguments or {}, user=request.user
+            )
         except RPCInvalidRequest as exc:
             return self.error_result(exc.message)
-
-        request = mcp_context.request
         if method.auth is not None and not method.auth(request):
             return self.error_result(f"Authentication failed for {name}")
 
diff --git a/tcms_enterprise/tests/test_mcp_server.py b/tcms_enterprise/tests/test_mcp_server.py
index 9de547d..a90aff2 100644
--- a/tcms_enterprise/tests/test_mcp_server.py
+++ b/tcms_enterprise/tests/test_mcp_server.py
@@ -6,6 +6,7 @@
 import json
 from datetime import timedelta
 from http import HTTPStatus
+from unittest.mock import patch
 
 from django.urls import reverse
 from django.utils import timezone
@@ -205,6 +206,22 @@ class TestMCPServer(LoggedInTestCase):  # pylint: disable=too-many-public-method
         )
         self.assertEqual(error["data"]["requested"], "1999-01-01")
 
+    def test_tools_call_should_pass_user_to_inspect_rpc_args(self):
+        user_should_have_perm(self.tester, "management.view_product")
+        with patch(
+            "tcms_enterprise.mcp_server.KiwiTCMSHandlerMixin.inspect_rpc_args"
+        ) as inspect_rpc_args:
+            self.call(
+                "tools/call",
+                {
+                    "name": "Product.filter",
+                    "arguments": {"query": {"name__icontains": "MCP"}},
+                },
+                bearer_token=self.bearer_token,
+            )
+
+        self.assertEqual(inspect_rpc_args.call_args.kwargs["user"].pk, self.tester.pk)
+
     def test_tools_call_should_reject_restricted_lookup_path(self):
         user_should_have_perm(self.tester, "testcases.view_testcase")
         response = self.call(
